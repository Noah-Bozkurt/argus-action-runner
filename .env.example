# Organization runner (recommended for Argus).
RUNNER_URL=https://github.com/Noah-Bozkurt
RUNNER_SCOPE=org
RUNNER_NAME_PREFIX=argus-runner
RUNNER_LABELS=argus,docker
RUNNER_GROUP=

# Set this to: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Optional: change where Compose reads the fine-grained PAT from.
RUNNER_PAT_FILE=./secrets/runner_pat
